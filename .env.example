# Copy this file to .env and fill in your own values:
#   cp .env.example .env
# Do NOT commit .env. It is listed in .gitignore.
# Notebooks call load_dotenv() to read these values, so keep secrets out of notebook cells.

# Hugging Face access token (https://huggingface.co/settings/tokens)
HF_TOKEN=

# OpenAI API key (used in chap07, chap08, chap09, chap12)
OPENAI_API_KEY=

# SerpAPI key (used in chap09)
SERPAPI_API_KEY=

# OpenWeatherMap API key (used in chap09, chap13)
OPENWEATHER_API_KEY=
